#include <iostream>
using namespace std;

int main()
{
    float base, altura, area;
    cout<<"Escribe la base del triangulo: ";
    cin>>base;
    cout<<"Escribe la altura del triangulo: ";
    cin>>altura;
    area = (base * altura) / 2;
    cout<<"El area del triangulo es: "<<area;

    return 0;
}
