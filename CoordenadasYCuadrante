#include <iostream>
using namespace std;
int main()
{
    //Escriba un programa que tome como entrada las coordenadas
    //de un punto en el plano cartesiano e indique al usuario en qué cuadrante se encuentra el punto.
    float x, y;
    char separador;
    cout<<"Escribe las coordenadas en el formato x,y: ";
    cin>>x>>separador>>y;
    
    if (x==0&&y==0) {
        cout<<"Esta en el origen.";
        return 0;}
        
    if (x==0) {
        cout<<"La coordenada introducida esta sobre el eje y.";
        return 0;}
        
    if (y==0) {
        cout<<"La coordenada introducida esta sobre el eje x.";
        return 0;}
        
    if ((x*y)>0){
        if (x>0){
            cout<<"Primer cuadrante.";
        }
        else {
            cout<<"Tercer cuadrante.";
        }
    }
    else {
        if (x>0){
            cout<<"Cuarto cuadrante.";
        }
        else {
            cout<<"Segundo cuadrante.";
        }
    }
    return 0;
}
