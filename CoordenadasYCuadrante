#include <iostream>
using namespace std;
int main()
{
    float x, y;
    char separador;
    cout<<"Escribe las coordenadas en el formato x,y: ";
    cin>>x>>separador>>y;
    
    if (x==0&&y==0) {
        cout<<"Esta en el origen.";
        return 0;}
        
    if (x==0) {
        cout<<"La coordenada introducida esta sobre el eje y.";
        return 0;}
        
    if (y==0) {
        cout<<"La coordenada introducida esta sobre el eje x.";
        return 0;}
        
    if ((x*y)>0){
        if (x>0){
            cout<<"Esta en el primer cuadrante.";
            return 0;
        }
        else {
            cout<<"Esta en el tercer cuadrante.";
            return 0;
        }
    }
    else {
        if (x>0){
            cout<<"Esta en el cuarto cuadrante.";
            return 0;
        }
        else {
            cout<<"Esta en el segundo cuadrante.";
            return 0;
        }
    }
    return 0;
}
