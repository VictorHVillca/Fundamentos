#include <iostream>
using namespace std;
int main()
{
	int n;
	bool flag = true;
	cout<<"Ingrese el numero que desea comprobar: ";
	cin>>n;

	if (n>1) {
		for (int i = 2; i*i<=n; i++) {
			if (n%i == 0 ) {
				flag = false;
				break;
			}
		}
		if (flag)
			cout<<"El numero es primo. \n";
		else
			cout<<"El numero no es primo. \n";
	}
	else {
		cout<<"Su numero no es valido. Debe ser mayor a 1. \n";
	}
	return 0;
}
