#include <iostream>
using namespace std;
int main()
{
	int n, numero = 2, c = 0;
	bool flag = true;
	int respuesta;
	do {
		cout << "Ingrese el numero de primos que desea: ";
		cin >> n;
		if (n >= 1) {
			while (c < n) {
				for (int i = 2; (i * i) <= numero; i++) {
					if (numero % i == 0) {
						flag = false;
						break;
					}
				}
				if (flag) {
					cout << numero << ", ";
					c++;
				}
				numero++;
				flag = true;
			}
		}
		else {
			cout << "Su numero no es valido. Debe ser mayor a 0.";
		}
		numero = 2;
		c = 0;
		cout << endl << "Quiere correr de nuevo el programa? (Si = 1, No = 0)"<<endl;
		cin >> respuesta;
	}  while (respuesta == 1);
	if (respuesta == 0)
		cout << "Ha salido del programa.";
	return 0;
}
