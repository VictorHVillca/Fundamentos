#include <iostream>
#include <cmath>
using namespace std;
int main()
{
    float lado1, lado2, lado3, s, area;
    cout<<"Escribe el primer lado del triangulo: ";
    cin>>lado1;
    cout<<"Escribe el segundo lado del triangulo: ";
    cin>>lado2;
    cout<<"Escribe el tercer lado del triangulo: ";
    cin>>lado3;
    s = (lado1 + lado2 + lado3) / 2;
    area = sqrt(s * (s - lado1) * (s - lado2) * (s - lado3));
    cout<<"El area del triangulo es: "<<area;
    return 0;
}
